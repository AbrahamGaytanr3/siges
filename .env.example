DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=
# Ruta del panel de administración, con slash final. En producción cámbiala
# por algo no adivinable, ej: DJANGO_ADMIN_URL=panel-9f3a2/
DJANGO_ADMIN_URL=admin/

# Correo saliente. Sin configurar, en DEBUG=True se usa la consola (no se
# envía nada real); en DEBUG=False se requiere SMTP real o fallará el envío.
# DJANGO_EMAIL_BACKEND=  # opcional, para forzar un backend específico
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=
